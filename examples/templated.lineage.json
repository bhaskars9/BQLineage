        "shop.sales.orders.order_ts"
      ],
      "steps": [
        {
          "column": "shop.dw.order_lines.sku",
          "expression": "i.sku",
          "from": [
            "_SESSION.todays_orders AS t",
            "shop.sales.order_items AS i"
          ],
          "joins": [
            "JOIN i ON t.order_id = i.order_id"
          ],
          "where": "i.qty >= 1"
        }
      ]
    }
  },
