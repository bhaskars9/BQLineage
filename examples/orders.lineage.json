{
  "version": 1,
  "tables": {
    "shop.dw.customer_revenue": [
      "shop.crm.customers",
      "shop.sales.orders"
    ]
  },
  "columns": {
    "shop.dw.customer_revenue.customer_id": {
      "sources": [
        "shop.crm.customers.customer_id",
        "shop.sales.orders.customer_id"
      ],
      "indirect_sources": [
        "shop.crm.customers.customer_id",
        "shop.crm.customers.name",
        "shop.crm.customers.region",
        "shop.sales.orders.customer_id",
        "shop.sales.orders.order_ts",
        "shop.sales.orders.status"
      ],
      "steps": [
        {
          "column": "shop.dw.customer_revenue.customer_id",
          "expression": "COALESCE(p.customer_id, c.customer_id)",
          "from": [
            "_SESSION.paid_orders AS p",
            "eu_customers AS c"
          ],
          "joins": [
            "JOIN c ON p.customer_id = c.customer_id"
          ],
          "group_by": [
            "COALESCE(p.customer_id, c.customer_id)",
            "c.name",
            "c.region"
          ]
        },
        {
          "column": "eu_customers.customer_id",
          "in": "shop.dw.customer_revenue",
          "expression": "customers.customer_id",
          "from": [
            "shop.crm.customers"
          ],
          "where": "customers.region = 'EU'"
        },
        {
          "column": "_SESSION.paid_orders.customer_id",
          "expression": "o.customer_id",
          "from": [
            "shop.sales.orders AS o"
          ],
          "where": "o.status = 'PAID' AND DATE(o.order_ts) = @run_date"
        }
      ]
    },
    "shop.dw.customer_revenue.customer_name": {
      "sources": [
        "shop.crm.customers.name"
      ],
      "indirect_sources": [
        "shop.crm.customers.customer_id",
        "shop.crm.customers.name",
        "shop.crm.customers.region",
        "shop.sales.orders.customer_id",
        "shop.sales.orders.order_ts",
        "shop.sales.orders.status"
      ],
      "steps": [
        {
          "column": "shop.dw.customer_revenue.customer_name",
          "expression": "c.name",
          "from": [
            "_SESSION.paid_orders AS p",
            "eu_customers AS c"
          ],
          "joins": [
            "JOIN c ON p.customer_id = c.customer_id"
          ],
          "group_by": [
            "COALESCE(p.customer_id, c.customer_id)",
            "c.name",
            "c.region"
          ]
        },
        {
          "column": "eu_customers.name",
          "in": "shop.dw.customer_revenue",
          "expression": "customers.name",
          "from": [
            "shop.crm.customers"
          ],
          "where": "customers.region = 'EU'"
        }
      ]
    },
    "shop.dw.customer_revenue.loaded_at": {
      "sources": [],
      "indirect_sources": [
        "shop.crm.customers.customer_id",
        "shop.crm.customers.name",
        "shop.crm.customers.region",
        "shop.sales.orders.customer_id",
        "shop.sales.orders.order_ts",
        "shop.sales.orders.status"
      ],
      "steps": [
        {
          "column": "shop.dw.customer_revenue.loaded_at",
          "expression": "CURRENT_TIMESTAMP()",
          "from": [
            "_SESSION.paid_orders AS p",
            "eu_customers AS c"
          ],
          "joins": [
            "JOIN c ON p.customer_id = c.customer_id"
          ],
          "group_by": [
            "COALESCE(p.customer_id, c.customer_id)",
            "c.name",
            "c.region"
          ]
        }
      ]
    },
    "shop.dw.customer_revenue.region": {
      "sources": [
        "shop.crm.customers.region"
      ],
      "indirect_sources": [
        "shop.crm.customers.customer_id",
        "shop.crm.customers.name",
        "shop.crm.customers.region",
        "shop.sales.orders.customer_id",
        "shop.sales.orders.order_ts",
        "shop.sales.orders.status"
      ],
      "steps": [
        {
          "column": "shop.dw.customer_revenue.region",
          "expression": "c.region",
          "from": [
            "_SESSION.paid_orders AS p",
            "eu_customers AS c"
          ],
          "joins": [
            "JOIN c ON p.customer_id = c.customer_id"
          ],
          "group_by": [
            "COALESCE(p.customer_id, c.customer_id)",
            "c.name",
            "c.region"
          ]
        },
        {
          "column": "eu_customers.region",
          "in": "shop.dw.customer_revenue",
          "expression": "customers.region",
          "from": [
            "shop.crm.customers"
          ],
          "where": "customers.region = 'EU'"
        }
      ]
    },
    "shop.dw.customer_revenue.revenue": {
      "sources": [
        "shop.sales.orders.amount"
      ],
      "indirect_sources": [
        "shop.crm.customers.customer_id",
        "shop.crm.customers.name",
        "shop.crm.customers.region",
        "shop.sales.orders.customer_id",
        "shop.sales.orders.order_ts",
        "shop.sales.orders.status"
      ],
      "steps": [
        {
          "column": "shop.dw.customer_revenue.revenue",
          "expression": "SUM(p.gross)",
          "from": [
            "_SESSION.paid_orders AS p",
            "eu_customers AS c"
          ],
          "joins": [
            "JOIN c ON p.customer_id = c.customer_id"
          ],
          "group_by": [
            "COALESCE(p.customer_id, c.customer_id)",
            "c.name",
            "c.region"
          ]
        },
        {
          "column": "_SESSION.paid_orders.gross",
          "expression": "o.amount * 1.2",
          "from": [
            "shop.sales.orders AS o"
          ],
          "where": "o.status = 'PAID' AND DATE(o.order_ts) = @run_date"
        }
      ]
    }
  },
  "issues": []
}
