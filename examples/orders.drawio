atus = 'PAID' AND DATE(o.order_ts) = @run_date&#10;rows decided by: shop.crm.customers.customer_id, shop.crm.customers.name, shop.crm.customers.region, shop.sales.orders.customer_id, shop.sales.orders.order_ts, shop.sales.orders.status"><mxCell style="text;align=left;verticalAlign=middle;spacingLeft=8;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c9"><mxGeometry x="0" y="30" width="208" height="24" as="geometry" /></mxCell></UserObject><UserObject id="c11" label="customer_name" tooltip="shop.dw.customer_revenue.customer_name = c.name&#10;    JOINS: JOIN c ON p.customer_id = c.customer_id&#10;    GROUP BY: COALESCE(p.customer_id, c.customer_id); c.name; c.region&#10;eu_customers.name (in shop.dw.customer_revenue) = customers.name&#10;    WHERE: customers.region = 'EU'&#10;rows decided by: shop.crm.customers.customer_id, shop.crm.customers.name, shop.crm.customers.region, shop.sales.orders.customer_id, shop.sales.orders.order_ts, shop.sales.orders.status"><mxCell style="text;align=left;verticalAlign=middle;spacingLeft=8;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c9"><mxGeometry x="0" y="54" width="208" height="24" as="geometry" /></mxCell></UserObject><UserObject id="c12" label="loaded_at" tooltip="shop.dw.customer_revenue.loaded_at = CURRENT_TIMESTAMP()&#10;    JOINS: JOIN c ON p.customer_id = c.customer_id&#10;    GROUP BY: COALESCE(p.customer_id, c.customer_id); c.name; c.region&#10;rows decided by: shop.crm.customers.customer_id, shop.crm.customers.name, shop.crm.customers.region, shop.sales.orders.customer_id, shop.sales.orders.order_ts, shop.sales.orders.status"><mxCell style="text;align=left;verticalAlign=middle;spacingLeft=8;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1" parent="c9"><mxGeometry x="0" y="78" width="208" height="24" as="geometry" /></mxCell></UserObject><UserObject id="c13" label="region" tooltip="shop.dw.customer_revenue.region = c.region&#10;    JOINS: JOIN c ON p.customer_id = 